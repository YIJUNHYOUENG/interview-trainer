<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".interview.InterviewActivity">

    <!-- 상단: 주제 진행 + 종료 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/App.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="주제 2/5"
            android:textSize="17sp" />

        <TextView
            style="@style/App.Text.Mut"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="· 꼬리질문 1/2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnd"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="종료" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- 대화 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/space_10"
            android:orientation="vertical"
            android:padding="16dp"
            android:showDividers="middle">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/App.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bubble_left"
                    android:lineSpacingExtra="3dp"
                    android:maxWidth="280dp"
                    android:padding="12dp"
                    android:text="Room 을 선택한 이유가 있나요? SharedPreferences 나 파일 저장 대신에요." />

                <TextView
                    style="@style/App.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingTop="6dp"
                    android:text="🔊 다시 듣기" />
            </LinearLayout>

            <TextView
                style="@style/App.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="@drawable/bubble_right"
                android:lineSpacingExtra="3dp"
                android:maxWidth="280dp"
                android:padding="12dp"
                android:text="학습 기록을 조회할 일이 많아서 쿼리가 필요했고, 그래서 Room 을 썼습니다." />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/App.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bubble_left"
                    android:lineSpacingExtra="3dp"
                    android:maxWidth="280dp"
                    android:padding="12dp"
                    android:text="쿼리가 필요하다고 하셨는데, 구체적으로 어떤 조회였나요?" />

                <TextView
                    style="@style/App.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingTop="6dp"
                    android:text="🔊 다시 듣기" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <!-- 음성 답변: 녹음 중 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 파형 자리 표시 (실제 녹음이 붙으면 소리 크기에 따라 움직이는 View 로 바꾼다) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View android:layout_width="4dp" android:layout_height="10dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_wave" />
            <View android:layout_width="4dp" android:layout_height="18dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_wave" />
            <View android:layout_width="4dp" android:layout_height="28dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_wave" />
            <View android:layout_width="4dp" android:layout_height="14dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_wave" />
            <View android:layout_width="4dp" android:layout_height="32dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_wave" />
            <View android:layout_width="4dp" android:layout_height="20dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_wave" />
            <View android:layout_width="4dp" android:layout_height="8dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_wave" />
            <View android:layout_width="4dp" android:layout_height="24dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_wave" />
            <View android:layout_width="4dp" android:layout_height="16dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_wave" />
            <View android:layout_width="4dp" android:layout_height="26dp" android:layout_marginEnd="3dp" android:background="@drawable/bg_wave" />
            <View android:layout_width="4dp" android:layout_height="12dp" android:background="@drawable/bg_wave" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/App.Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● 00:23"
                android:textColor="@color/bad" />

            <TextView
                style="@style/App.Text.Mut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="녹음 중" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="완료"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/bad"
            app:cornerRadius="36dp" />

        <TextView
            style="@style/App.Text.Mut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="누르면 답변 종료 · 텍스트로 입력" />
    </LinearLayout>
</LinearLayout>
