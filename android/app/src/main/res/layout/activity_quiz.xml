<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".concept.QuizActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_close"
        app:title="오늘의 퀴즈" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/space_10"
            android:orientation="vertical"
            android:padding="16dp"
            android:showDividers="middle">

            <!-- 진행 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="3"
                    android:progress="2"
                    app:indicatorColor="@color/acc"
                    app:trackColor="@color/track"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <TextView
                    style="@style/App.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="2 / 3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:text="네트워크" />

                <TextView
                    style="@style/App.Text.Mut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="TCP 와 UDP" />
            </LinearLayout>

            <!-- 문제 -->
            <TextView
                style="@style/App.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="TCP 가 연결을 맺을 때 쓰는 절차로 알맞은 것은?"
                android:textSize="18sp" />

            <!-- 보기 1 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        style="@style/App.Text.Caption"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="1" />

                    <TextView
                        style="@style/App.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2-way handshake" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 보기 2: 내가 고른 오답 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card.Bad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        style="@style/App.Text.Caption"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="2" />

                    <TextView
                        style="@style/App.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4-way handshake" />

                    <TextView
                        style="@style/App.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✕ 내 선택"
                        android:textColor="@color/bad" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 보기 3: 정답 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card.Ok"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        style="@style/App.Text.Caption"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="3" />

                    <TextView
                        style="@style/App.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3-way handshake" />

                    <TextView
                        style="@style/App.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ 정답"
                        android:textColor="@color/ok" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 보기 4 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <TextView
                        style="@style/App.Text.Caption"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="4" />

                    <TextView
                        style="@style/App.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Slow start" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 해설 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/App.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="해설" />

                    <TextView
                        style="@style/App.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:text="TCP 는 SYN → SYN+ACK → ACK 세 번의 메시지를 주고받아 연결을 맺는다(3-way handshake). 4-way handshake 는 연결을 끊을 때 쓰는 절차다." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="12dp"
        android:text="다음 문제" />
</LinearLayout>
