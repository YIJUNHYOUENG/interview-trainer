<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".concept.QuizResultActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="퀴즈 결과" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/space_10"
            android:orientation="vertical"
            android:padding="16dp"
            android:showDividers="middle">

            <!-- 점수 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/App.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오늘의 퀴즈 완료" />

                    <TextView
                        style="@style/App.Text.Big"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 / 3"
                        android:textSize="40sp" />

                    <TextView
                        style="@style/App.Text.Mut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="내일 새 퀴즈가 열려요" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/App.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="문제별 결과" />

            <!-- 문제 1 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/App.Text.Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✓ 프로세스와 스레드"
                            android:textColor="@color/ok" />

                        <TextView
                            style="@style/App.Tag.Ok"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lv.2 → 3" />
                    </LinearLayout>

                    <TextView
                        style="@style/App.Text.Mut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="다음 복습: 4일 뒤" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 문제 2 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/App.Text.Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✕ TCP 와 UDP"
                            android:textColor="@color/bad" />

                        <TextView
                            style="@style/App.Tag.Bad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lv.3 → 2" />
                    </LinearLayout>

                    <TextView
                        style="@style/App.Text.Mut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="다음 복습: 2일 뒤 · 오답노트에 추가됨" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 문제 3 -->
            <com.google.android.material.card.MaterialCardView
                style="@style/App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/App.Text.Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✓ 인덱스"
                            android:textColor="@color/ok" />

                        <TextView
                            style="@style/App.Tag.Ok"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lv.1 → 2" />
                    </LinearLayout>

                    <TextView
                        style="@style/App.Text.Mut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="다음 복습: 2일 뒤" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/space_10"
        android:orientation="horizontal"
        android:padding="12dp"
        android:showDividers="middle">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWrong"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="오답노트 보기" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="홈으로" />
    </LinearLayout>
</LinearLayout>
