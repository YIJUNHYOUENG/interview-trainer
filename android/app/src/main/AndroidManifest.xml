<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17(API 37)부터 10.0.2.2 같은 사설 IP(PC 서버)에 붙으려면 필요한 런타임 권한.
         없으면 연결이 오류 없이 타임아웃만 난다 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- networkSecurityConfig: PC 서버(10.0.2.2)는 http 라서 그 주소만 평문 통신 허용 -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InterviewTrainer">

        <!-- 모든 화면은 세로 고정 (docs/DESIGN.md 5장) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CS 개념 학습 -->
        <activity android:name=".concept.ConceptListActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".concept.ConceptDetailActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".concept.QuizActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".concept.QuizResultActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".concept.WrongNoteActivity" android:exported="false" android:screenOrientation="portrait" />

        <!-- AI 모의 면접 -->
        <activity android:name=".interview.InterviewHomeActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".interview.InterviewSettingsActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".interview.InterviewActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".interview.ReportActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".interview.HistoryActivity" android:exported="false" android:screenOrientation="portrait" />
    </application>

</manifest>
